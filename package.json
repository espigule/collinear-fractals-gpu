{
  "name": "collinear-fractals-gpu",
  "version": "0.2.0-alpha",
  "private": true,
  "description": "Development checks for the build-free Collinear Fractals explorer",
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node qa/check.cjs",
    "test:browser": "playwright test",
    "test:gpu": "playwright test --config playwright.gpu.config.cjs",
    "test:all": "npm test && npm run test:browser && npm run test:gpu",
    "bench": "node tools/bench/search_bench.mjs",
    "site:stage": "python tools/stage_site.py",
    "serve": "python -m http.server 4173 --bind 127.0.0.1"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
