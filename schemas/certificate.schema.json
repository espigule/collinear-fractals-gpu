{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/espigule/collinear-fractals-gpu/schemas/certificate.schema.json",
  "title": "Collinear Fractals GPU certificate",
  "type": "object",
  "required": [
    "schema_version",
    "software_version",
    "n",
    "N",
    "c",
    "k_max",
    "L_max",
    "verdict",
    "renderer",
    "proof_status",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "software_version": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "n": {
      "type": "integer",
      "minimum": 2
    },
    "N": {
      "type": "integer",
      "minimum": 3
    },
    "c": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "re",
        "im"
      ],
      "properties": {
        "re": {
          "type": "number"
        },
        "im": {
          "type": "number"
        }
      },
      "additionalProperties": true,
      "description": "Effective parameter used by the search. Null only when a reciprocal input exceeds finite numerical range; input_parameter preserves entered coordinates."
    },
    "k_max": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum inverse depth; zero tests only the initial point."
    },
    "L_max": {
      "type": "integer",
      "minimum": 1,
      "description": "Per-depth retained-frontier cap, not a total node budget."
    },
    "verdict": {
      "enum": [
        "Interior",
        "Interior-offLens",
        "Exterior",
        "Undetermined"
      ]
    },
    "word": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "digits": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "trap": {
      "type": [
        "object",
        "null"
      ]
    },
    "enclosure": {
      "type": [
        "object",
        "null"
      ]
    },
    "renderer": {
      "type": "string"
    },
    "minimum_capture_depth": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Minimum inverse depth in the separate selected-point search. Null when no minimum is established."
    },
    "trap_policy": { "enum": ["canonical-only"] },
    "finite_capture": {
      "type": "object",
      "required": ["capture_style", "cycle", "maximum_depth", "sample_type", "boundary_coverage_sampling", "minimum_depth_convention"],
      "properties": {
        "capture_style": { "enum": ["depth", "sets"] },
        "cycle": { "type": "integer", "minimum": 1, "maximum": 12 },
        "maximum_depth": {
          "type": "integer", "minimum": 0, "maximum": 100,
          "description": "Requested maximum center-capture depth from k_max, independent of adaptive boundary escape depth. Active GPU preview limits are reported separately."
        },
        "sample_type": { "const": "pixel-center" },
        "boundary_coverage_sampling": {
          "type": "object",
          "required": ["parameter", "original_attractor", "half_difference"],
          "properties": {
            "parameter": { "const": "whole-pixel" },
            "original_attractor": { "const": "whole-pixel" },
            "half_difference": { "const": "pixel-center" }
          },
          "additionalProperties": false,
          "description": "Coverage sampling for each numerical view. Original-attractor whole-pixel coverage applies to Sharp boundary; advanced renderers are outside this capture-display scope."
        },
        "minimum_depth_convention": { "type": "string" },
        "whole_attractor_initial_depth": { "const": 0 },
        "fixed_first_digit_initial_depth": { "const": 1 },
        "unknown_minimum": { "type": "null" },
        "packed_unknown_minimum": { "const": 255 },
        "witness_without_minimum": { "type": "string" },
        "selected_point_record": { "type": "string" },
        "scope": { "type": "string" }
      },
      "additionalProperties": true,
      "description": "Capture display state and sampling convention. Minimum levels are computed at pixel centers. Parameter and original-attractor Sharp boundary coverage use whole pixels; the half-difference is point-sampled. The selected-point record remains separate."
    },
    "visual_renderer": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "capture_style": { "enum": ["depth", "sets"] },
        "capture_cycle": { "type": "integer", "minimum": 1, "maximum": 12 },
        "capture_depth_sampling": { "const": "pixel-center" },
        "capture_maximum_depth": { "type": "integer", "minimum": 0, "maximum": 100 },
        "effective_capture_depth": { "type": "integer", "minimum": 0, "maximum": 100 },
        "renderer_mode": {
          "enum": [
            "boundary",
            "prefix",
            "histogram",
            "survival"
          ]
        },
        "requested_base_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "adaptive": {
          "type": "boolean"
        },
        "effective_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "pixel_radius_world": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true,
      "description": "Optional visual-renderer metadata. This is not a proof field."
    },
    "parameter_view": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["mn", "mn0", "mn1", "compare", "rn"]
        },
        "layers": {
          "type": "array",
          "items": { "enum": ["mn", "mn0", "mn1"] },
          "uniqueItems": true,
          "maxItems": 3,
          "description": "Independently selected aggregate layers. An empty selection is valid."
        },
        "digits": {
          "type": "array",
          "items": { "type": "integer" },
          "uniqueItems": true,
          "description": "Selected first digits t in D_n. Every corresponding subset uses A_n for all later digits."
        },
        "search_record_set": {
          "const": "M_n"
        },
        "capture_style": { "enum": ["depth", "sets"] },
        "capture_cycle": { "type": "integer", "minimum": 1, "maximum": 12 },
        "capture_depth_sampling": { "const": "pixel-center" },
        "capture_maximum_depth": { "type": "integer", "minimum": 0, "maximum": 100 },
        "escape_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "work_limit": {
          "type": "integer",
          "minimum": 1
        },
        "mn": { "$ref": "#/$defs/point_capture_result" },
        "mn0": { "$ref": "#/$defs/point_capture_result" },
        "mn1": { "$ref": "#/$defs/point_capture_result" },
        "digit_results": {
          "type": "object",
          "propertyNames": { "pattern": "^-?[0-9]+$" },
          "additionalProperties": { "$ref": "#/$defs/point_capture_result" },
          "description": "Point-search results keyed by the selected integer first digit."
        },
        "raster_sampling": {
          "const": "parameter-cell"
        },
        "raster_visible": {
          "type": "boolean"
        },
        "raster_parameter_radius": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Actual pixel-cell radius in the displayed parameter coordinates before reciprocal conversion. Null when the parameter canvas is hidden."
        },
        "selected_point_sampling": {
          "const": "point"
        },
        "finite_survival": { "type": "string" }
      },
      "additionalProperties": true,
      "description": "Independent layer selections and auxiliary point-search results, separate from parameter-cell image coverage and the main connectedness record."
    },
    "proof_status": {
      "enum": [
        "finite-search-certificate",
        "theorem-certified",
        "illustrative",
        "exploratory",
        "bounded-search-undetermined"
      ],
      "description": "Legacy status vocabulary. finite-search-certificate denotes a floating-point record, not an interval-verified proof."
    },
    "limitations": {
      "type": "string"
    },
    "stop_reason": {
      "enum": [
        "invalid-input",
        "outside-domain",
        "numerical-range",
        "enclosure-escape",
        "trap-hit",
        "tree-exhausted",
        "node-cap",
        "depth-cap",
        null
      ]
    },
    "tol": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Target for the unscaled enclosure-series tail; not a bound on all arithmetic error."
    },
    "depth": {
      "type": "integer",
      "minimum": 0
    },
    "arithmetic": {
      "type": [
        "string",
        "object"
      ],
      "description": "Arithmetic provenance; finite-search verdicts are not interval-verified by this schema."
    },
    "nodes_explored": {
      "type": "integer",
      "minimum": 0
    },
    "input_parameter": {
      "type": "object",
      "required": [
        "re",
        "im"
      ],
      "properties": {
        "re": {
          "type": "number"
        },
        "im": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "effective_c": {
      "type": [
        "object",
        "null"
      ],
      "description": "Expanding parameter used by the search after any reciprocal normalization."
    },
    "parameter_convention": {
      "enum": [
        "expanding-parameter",
        "reciprocal-input"
      ]
    },
    "in_lens": {
      "type": "boolean"
    },
    "trap_region": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "description": "Floating-point finite-search record. Schema validity does not verify the mathematical result.",
  "$defs": {
    "point_capture_result": {
      "type": ["object", "null"],
      "properties": {
        "minimumCaptureDepth": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Minimum inverse depth established after every shallower search completes. Null means the minimum is not established, even if a capture witness is retained."
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "c": {
            "type": "null"
          }
        },
        "required": [
          "c"
        ]
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "Undetermined"
          },
          "stop_reason": {
            "const": "numerical-range"
          }
        },
        "required": [
          "input_parameter",
          "stop_reason"
        ]
      }
    }
  ]
}
