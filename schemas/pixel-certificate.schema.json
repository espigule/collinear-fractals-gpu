{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/espigule/collinear-fractals-gpu/schemas/pixel-certificate.schema.json",
  "title": "Collinear Fractals GPU pixel certificate",
  "type": "object",
  "required": [
    "schema_version",
    "software_version",
    "pixel",
    "world",
    "n",
    "N",
    "k_max",
    "L_max",
    "verdict",
    "proof_status",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "software_version": {
      "type": "string"
    },
    "pixel": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "world": {
      "$ref": "#/$defs/complex"
    },
    "c": {
      "$ref": "#/$defs/complex"
    },
    "n": {
      "type": "integer",
      "minimum": 2
    },
    "N": {
      "type": "integer",
      "minimum": 3
    },
    "k_max": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum inverse depth; zero tests only the initial point."
    },
    "L_max": {
      "type": "integer",
      "minimum": 1,
      "description": "Per-depth retained-frontier cap, not a total node budget."
    },
    "verdict": {
      "enum": [
        "Interior",
        "Interior-offLens",
        "Member",
        "Exterior",
        "Undetermined"
      ]
    },
    "word": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "proof_status": {
      "type": "string",
      "description": "Legacy status vocabulary. finite-search-certificate denotes a floating-point record, not an interval-verified proof."
    },
    "limitations": {
      "type": "string"
    },
    "stop_reason": {
      "enum": [
        "invalid-input",
        "outside-domain",
        "numerical-range",
        "enclosure-escape",
        "analytic-membership",
        "analytic-exterior",
        "trap-hit",
        "tree-exhausted",
        "node-cap",
        "depth-cap"
      ]
    },
    "tol": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Target for the unscaled enclosure-series tail; not a bound on all arithmetic error."
    },
    "depth": {
      "type": "integer",
      "minimum": 0
    },
    "arithmetic": {
      "type": [
        "string",
        "object"
      ],
      "description": "Arithmetic provenance; finite-search verdicts are not interval-verified by this schema."
    },
    "nodes_explored": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "complex": {
      "type": "object",
      "required": [
        "re",
        "im"
      ],
      "properties": {
        "re": {
          "type": "number"
        },
        "im": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "description": "Floating-point finite-search record. Schema validity does not verify the mathematical result."
}
